uploads/
server/uploads/
client/public/uploads/

# Logs
*.log
npm-debug.log*

# Keys and certificates
*.pem
*.key
*.p12
*.pfx

# Test coverage
coverage/

# Deploy artifacts
gsky-deploy.zip
.vercel/

# OS
.DS_Store
Thumbs.db

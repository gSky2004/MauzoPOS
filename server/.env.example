# Gsky Sport Shoes — Server environment
# Copy this file to .env and fill in real values. NEVER commit .env.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
# For local Windows installs (pg 18) use:
# Format: postgres://USER:PASSWORD@localhost:5432/gsky
# NEVER put a real password in this file — it is committed to git.
DATABASE_URL=postgres://postgres:CHANGE_THIS_PASSWORD@localhost:5432/gsky

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Client (React dev server)
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads

# Payment provider
# Providers: sandbox (simulated Tanzania gateway), selcom, pesapal, mobile-money (to be connected)
PAYMENT_PROVIDER=sandbox
# Sandbox only: simulate the gateway confirming payment after a short delay
PAYMENT_SANDBOX_AUTO_CONFIRM=true
# Real gateway credentials (leave empty until connected)
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_CALLBACK_URL=

# Email provider
# Providers: log (print to console, no real sending), smtp
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Gsky Sport Shoes <no-reply@gskyshoes.co.tz>"

# Seeded admin account
ADMIN_NAME=Gsky Admin
ADMIN_EMAIL=admin@gskyshoes.co.tz
ADMIN_PHONE=0675029833
ADMIN_PASSWORD=Admin@1234

# Seeded shopkeeper (Smart POS demo)
SHOPKEEPER_EMAIL=shop@gsky.co.tz
SHOPKEEPER_PASSWORD=Shop@1234

# WhatsApp
WHATSAPP_NUMBER=0675029833

# AI Business Assistant (Gemini free tier only)
# NEVER put the real key here. Copy to .env (gitignored) only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

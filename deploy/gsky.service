[Unit]
Description=Gsky Sport Shoes API server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=gsky
Group=gsky
WorkingDirectory=/opt/gsky/server
Environment=NODE_ENV=production
EnvironmentFile=/opt/gsky/server/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# Client environment.
# Copy to .env for local dev, or set in the Vercel dashboard for production.
# Production value = your Render backend URL (no trailing slash), e.g.:
# VITE_API_BASE_URL=https://mauzopos-api.onrender.com
# Leave empty for same-origin (VPS setup where the API serves the site).
VITE_API_BASE_URL=
